   75          // 函数: void EEPROM_SectorErase(uint32_t EE_address)
   76          // 描述: 擦除一个扇区.
   77          // 参数: EE_address:  要擦除的EEPROM的扇区中的一个字节地址.
   78          // 返回: none.
   79          // 版本: V1.0, 2014-6-30
   80          //========================================================================
   81          void EEPROM_SectorErase(uint32_t EE_address)
   82          {
   83   1          IAP_ENABLE();                       //设置等待时间，允许IAP操作，送一次就够
   84   1          IAP_ERASE();                        //宏调用, 送扇区擦除命令，命令不需改变时，不需重新送命令
   85   1                                              //只有扇区擦除，没有字节擦除，512字节/扇区。
   86   1                                              //扇区中任意一个字节地址都是扇区地址。
   87   1          IAP_ADDRE = (uint8_t)(EE_address >> 16); //送扇区地址高字节（地址需要改变时才需重新送地址）
   88   1          IAP_ADDRH = (uint8_t)(EE_address >> 8);  //送扇区地址中字节（地址需要改变时才需重新送地址）
   89   1          IAP_ADDRL = (uint8_t)EE_address;         //送扇区地址低字节（地址需要改变时才需重新送地址）
   90   1          EEPROM_Trig();                      //触发EEPROM操作
   91   1          DisableEEPROM();                    //禁止EEPROM操作
   92   1      }
