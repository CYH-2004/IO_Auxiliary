   95          // 函数: void EEPROM_read_n(uint32_t EE_address,uint8_t *DataAddress,uint8_t lenth)
   96          // 描述: 读N个字节函数.
   97          // 参数: EE_address:  要读出的EEPROM的首地址.
   98          //       DataAddress: 要读出数据的指针.
   99          //       length:      要读出的长度
  100          // 返回: 0: 写入正确.  1: 写入长度为0错误.  2: 写入数据错误.
  101          // 版本: V1.0, 2014-6-30
  102          //========================================================================
  103          void EEPROM_read_n(uint32_t EE_address,uint8_t *DataAddress,uint8_t length)
  104          {
  105   1          IAP_ENABLE();                           //设置等待时间，允许IAP操作，送一次就够
  106   1          IAP_READ();                             //送字节读命令，命令不需改变时，不需重新送命令
  107   1          do
  108   1          {
  109   2              IAP_ADDRE = (uint8_t)(EE_address >> 16); //送地址高字节（地址需要改变时才需重新送地址）
  110   2              IAP_ADDRH = (uint8_t)(EE_address >> 8);  //送地址中字节（地址需要改变时才需重新送地址）
  111   2              IAP_ADDRL = (uint8_t)EE_address;         //送地址低字节（地址需要改变时才需重新送地址）
  112   2              EEPROM_Trig();                      //触发EEPROM操作
  113   2              *DataAddress = IAP_DATA;            //读出的数据送往
  114   2              EE_address++;
  115   2              DataAddress++;
  116   2          }while(--length);
  117   1      
  118   1          DisableEEPROM();
  119   1      }
