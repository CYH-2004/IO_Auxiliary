C251 COMPILER V5.60.0,  EEPROM                                                             26/11/26  10:59:29  PAGE 3   

  124          // 描述: 写N个字节函数.
  125          // 参数: EE_address:  要写入的EEPROM的首地址.
  126          //       DataAddress: 要写入数据的指针.
  127          //       length:      要写入的长度
  128          // 返回: 0: 写入正确.  1: 写入长度为0错误.  2: 写入数据错误.
  129          // 版本: V1.0, 2014-6-30
  130          //========================================================================
  131          uint8_t EEPROM_write_n(uint32_t EE_address,uint8_t *DataAddress,uint8_t length)
  132          {
  133   1          uint8_t  i;
  134   1          uint16_t j;
  135   1          uint8_t  *p;
  136   1          
  137   1          if(length == 0) return 1;   //长度为0错误
  138   1      
  139   1          IAP_ENABLE();                       //设置等待时间，允许IAP操作，送一次就够
  140   1          i = length;
  141   1          j = EE_address;
  142   1          p = DataAddress;
  143   1          IAP_WRITE();                            //宏调用, 送字节写命令
  144   1          do
  145   1          {
  146   2              IAP_ADDRE = (uint8_t)(EE_address >> 16); //送地址高字节（地址需要改变时才需重新送地址）
  147   2              IAP_ADDRH = (uint8_t)(EE_address >> 8);  //送地址中字节（地址需要改变时才需重新送地址）
  148   2              IAP_ADDRL = (uint8_t)EE_address;         //送地址低字节（地址需要改变时才需重新送地址）
  149   2              IAP_DATA  = *DataAddress;           //送数据到IAP_DATA，只有数据改变时才需重新送
  150   2              EEPROM_Trig();                      //触发EEPROM操作
  151   2              EE_address++;                       //下一个地址
  152   2              DataAddress++;                      //下一个数据
  153   2          }while(--length);                       //直到结束
  154   1      
  155   1          EE_address = j;
  156   1          length = i;
  157   1          DataAddress = p;
  158   1          i = 0;
  159   1          IAP_READ();                             //读N个字节并比较
  160   1          do
  161   1          {
  162   2              IAP_ADDRE = (uint8_t)(EE_address >> 16); //送地址高字节（地址需要改变时才需重新送地址）
  163   2              IAP_ADDRH = (uint8_t)(EE_address >> 8);  //送地址中字节（地址需要改变时才需重新送地址）
  164   2              IAP_ADDRL = (uint8_t)EE_address;         //送地址低字节（地址需要改变时才需重新送地址）
  165   2              EEPROM_Trig();                      //触发EEPROM操作
  166   2              if(*DataAddress != IAP_DATA)        //读出的数据与源数据比较
  167   2              {
  168   3                  i = 2;
  169   3                  break;
  170   3              }
  171   2              EE_address++;
  172   2              DataAddress++;
  173   2          }while(--length);
  174   1      
  175   1          DisableEEPROM();
  176   1          return i;
  177   1      }


