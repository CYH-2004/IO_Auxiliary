C251 COMPILER V5.60.0,  EEPROM                                                             26/11/26  10:59:29  PAGE 2   

   58          //========================================================================
   59          void EEPROM_Trig(void)
   60          {
   61   1          F0 = EA;    //保存全局中断
   62   1          EA = 0;     //禁止中断, 避免触发命令无效
   63   1          IAP_TRIG = 0x5A;
   64   1          IAP_TRIG = 0xA5;                    //先送5AH，再送A5H到IAP触发寄存器，每次都需要如此
   65   1                                              //送完A5H后，IAP命令立即被触发启动
   66   1                                              //CPU等待IAP完成后，才会继续执行程序。
   67   1          _nop_();   //由于STC32G是多级流水线的指令系统，触发命令后建议加4个NOP，保证IAP_DATA的数据完成准备
   68   1          _nop_();
   69   1          _nop_();
   70   1          _nop_();
   71   1          EA = F0;    //恢复全局中断
   72   1      }
