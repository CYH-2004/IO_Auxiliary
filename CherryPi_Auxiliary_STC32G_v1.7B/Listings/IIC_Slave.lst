   32          // I2C中断服务程序
   33          void I2C_Isr() interrupt 24
   34          {
   35   1          if (I2CSLST & STAIF)                         // 处理START事件
   36   1          {
   37   2              isda = 1;
   38   2              isma_h = 1;
   39   2              isma_l = 1;
   40   2              I2CSLST &= ~0X40;   // 清除标志位
   41   2          }
   42   1          else if (I2CSLST & RXIF)                    // 处理RECV事件，SLACKO设置为0
   43   1          {
   44   2              if (isda)                               // 从机地址匹配成功，准备数据接收
   45   2              {
   46   3                  isda = 0;                           // 处理RECV事件（RECV DEVICE ADDR）
   47   3              }
   48   2              else if (isma_h)                        // 接收目标寄存器高位地址（RECV MEMORY ADDR HIGH）
   49   2              {
   50   3                  isma_h = 0;
   51   3                  addr_target = (uint16_t)(I2CRXD << 8);
   52   3              }
   53   2              else if (isma_l)                        // 接收目标寄存器低位地址（RECV MEMORY ADDR LOW）
   54   2              {
   55   3                  isma_l = 0;
   56   3                  addr_target += I2CRXD;              
   57   3                  addr_target_temp = addr_target;
   58   3                  if(addr_target >= storage_size) I2CTXD = 0xFF;    // 访问越界
