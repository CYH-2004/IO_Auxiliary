   59   3                  else I2CTXD = storage_target[addr_target];        // 预载发送数据
   60   3              }
   61   2              else                                    // 处理RECV事件（RECV DATA）
   62   2              {
   63   3                  if(addr_target < storage_size)         // 越界检测
   64   3                  {
   65   4                      if(buf_count < WRITE_BUF_NUM)  // 缓冲区检测
   66   4                      {
   67   5                          if(data_count_temp < WRITE_BUF_ZIZE)
